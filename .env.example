# Copy this file to .env.local and fill in real values. Never commit .env.local.

# From your Discord application (Discord Developer Portal > OAuth2 > General)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# NextAuth needs a random secret to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The URL this site is running at. For local dev, leave as-is.
NEXTAUTH_URL=http://localhost:3000

# JonnyBot's internal API (online members / scheduled events). Must match INTERNAL_API_SECRET
# on JonnyBot's side exactly. If JonnyBot is running locally (e.g. the "JonnyBot Dev" run
# config), point this at its internal API port (default 8081).
JONNYBOT_INTERNAL_API_URL=http://localhost:8081
JONNYBOT_INTERNAL_API_SECRET=

# The RSClans hub (metorrite/rsclans-hub). Unset = RS Link and RuneSync keep going to JonnyBot as today. Set, the RS Link sign-in page,
# the RS Link plugin proxy and RuneSync uploads go to the hub instead. HUB_WEB_SECRET must equal the hub's HUB_WEB_SECRET.
HUB_BASE_URL=
HUB_WEB_SECRET=

# Bot dashboard (/dashboard), the beta page where server owners install and set up JonnyBot.
# While it's in beta only admins of the home server can open it. Set to "true" to open it to
# anyone who manages a server JonnyBot is in.
DASHBOARD_PUBLIC=false
# The bot's Discord application id, for the "Add JonnyBot to a server" link. Leave blank when it's
# the same application as DISCORD_CLIENT_ID.
DISCORD_BOT_CLIENT_ID=

# Where JonnyBot users go for help (a Discord invite or https page). Unset = the JonnyBot FAQ and privacy page point at the Younglings Discord.
JONNYBOT_SUPPORT_URL=

# The events hub (T-216/T-217): "true" offers "Open to everyone" on events and shows open events on the clans hub. Off by default.
EVENTS_HUB=

# Hosts (optional; leave all blank for one host, as in local development). See README "Hosts and domains".
# SITE_HOSTS=
# SITE_HOST_ALIASES=
# SITE_TENANT_SUFFIX=
# CLAN_SITES=

# RS Link sign-in page and plugin proxy (T-114). Off by default; see the bot's docs/LINK-SYSTEM.md.
# "true" turns on /link, /api/link/v1/... (the plugin) and /api/link/web/... (the sign-in page).
LINK_ENABLED=
# The address players see in the plugin ("enter this code at ..."). Unset = NEXTAUTH_URL.
LINK_PUBLIC_BASE_URL=
# A Discord application just for RS Link sign-in. Unset = DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET.
# Register <LINK_PUBLIC_BASE_URL>/api/link/web/auth/callback as a redirect on that application.
LINK_DISCORD_CLIENT_ID=
LINK_DISCORD_CLIENT_SECRET=
# Seals the sign-in page's cookie: at least 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Required when LINK_ENABLED.
LINK_COOKIE_KEY=
# The sign-in page's own hostname (e.g. link.example.org). Unset = only under /link on any host, or the "link" host of SITE_HOSTS.
LINK_HOST=
# Shown on the sign-in page: where the plugin's source is, and who to contact about it. Both optional.
LINK_SOURCE_URL=
LINK_CONTACT_EMAIL=

# Local layout review only: "true" fills the clans hub and clan sites with made-up clans. Never set on a real server.
# HUB_DEMO=
