# Copy this file to .env.local and fill in real values. Never commit .env.local.

# From your Discord application (Discord Developer Portal > OAuth2 > General)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# NextAuth needs a random secret to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The URL this site is running at. For local dev, leave as-is.
NEXTAUTH_URL=http://localhost:3000

# JonnyBot's internal API (online members / scheduled events). Must match INTERNAL_API_SECRET
# on JonnyBot's side exactly. If JonnyBot is running locally (e.g. the "JonnyBot Dev" run
# config), point this at its internal API port (default 8081).
JONNYBOT_INTERNAL_API_URL=http://localhost:8081
JONNYBOT_INTERNAL_API_SECRET=
